<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="issue36 installer evidence v2">
 <Profiles>
  <SystemCollector Id="JournalCollector" Name="Issue36 Journal Smoke">
   <BufferSize Value="1024"/><Buffers Value="128"/>
  </SystemCollector>
  <SystemProvider Id="JournalProvider">
   <Keywords><Keyword Value="ProcessThread"/><Keyword Value="Loader"/><Keyword Value="DiskIO"/><Keyword Value="DiskIOInit"/><Keyword Value="FileIO"/><Keyword Value="FileIOInit"/></Keywords>
   <Stacks><Stack Value="FileCreate"/><Stack Value="FileWrite"/><Stack Value="FileFlush"/><Stack Value="DiskWriteInit"/></Stacks>
  </SystemProvider>
  <Profile Id="InstallerJournal.Verbose.Memory" Name="InstallerJournal" Description="Pinned binary/npm journal stack capture" LoggingMode="Memory" DetailLevel="Verbose">
   <Collectors><SystemCollectorId Value="JournalCollector"><SystemProviderId Value="JournalProvider"/></SystemCollectorId></Collectors>
  </Profile>
 </Profiles>
</WindowsPerformanceRecorder>
