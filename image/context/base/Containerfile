FROM debian:trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && rm -rf /var/lib/apt/lists/*

COPY check-nodesource-key.sh nodesource-signing-key.fingerprint /tmp/nodesource-check/

RUN set -eu; \
    key_file=$(mktemp); \
    trap 'rm -f "$key_file"' EXIT; \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key -o "$key_file"; \
    bash /tmp/nodesource-check/check-nodesource-key.sh "$key_file" /tmp/nodesource-check/nodesource-signing-key.fingerprint; \
    rm -rf /tmp/nodesource-check; \
    mkdir -p /etc/apt/keyrings; \
    gpg --batch --yes --dearmor --output /etc/apt/keyrings/nodesource.gpg "$key_file"; \
    printf '%s\n' 'deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main' \
        > /etc/apt/sources.list.d/nodesource.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends nodejs; \
    rm -rf /var/lib/apt/lists/*

# Keep the sandbox running until sshd becomes its main process (#49).
ENTRYPOINT ["sh", "-c", "trap 'exit 0' TERM; sleep infinity & wait"]
