FROM debian:trixie-slim
ARG DEBIAN_FRONTEND=noninteractive

ENV PATH="${PATH}:/home/agent/.local/bin"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg git \
        gh tmux openssh-server openssh-client \
        bash coreutils findutils procps jq ripgrep less unzip zip xz-utils file libatomic1 \
    && rm -f /etc/ssh/ssh_host_* \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 agent \
    && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash agent \
    && mkdir -p /workspace /run/sshd \
    && chown agent:agent /workspace

COPY check-signing-key.sh nodesource-signing-key.fingerprint tailscale-signing-key.fingerprint /tmp/signing-key-check/

RUN set -eu; \
    key_file=$(mktemp); \
    trap 'rm -f "$key_file"' EXIT; \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key -o "$key_file"; \
    bash /tmp/signing-key-check/check-signing-key.sh "$key_file" /tmp/signing-key-check/nodesource-signing-key.fingerprint NodeSource; \
    mkdir -p /etc/apt/keyrings; \
    gpg --batch --yes --dearmor --output /etc/apt/keyrings/nodesource.gpg "$key_file"; \
    printf '%s\n' 'deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main' \
        > /etc/apt/sources.list.d/nodesource.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends nodejs; \
    rm -rf /var/lib/apt/lists/*

# Tailscale for the T3 Code Tool's tailnet node (ADR-0010): the node runs in userspace networking mode as agent, started by the manager, never at container start.
RUN set -eu; \
    key_file=$(mktemp); \
    trap 'rm -f "$key_file"' EXIT; \
    curl -fsSL https://pkgs.tailscale.com/stable/debian/trixie.noarmor.gpg -o "$key_file"; \
    bash /tmp/signing-key-check/check-signing-key.sh "$key_file" /tmp/signing-key-check/tailscale-signing-key.fingerprint Tailscale; \
    rm -rf /tmp/signing-key-check; \
    mkdir -p /etc/apt/keyrings; \
    cp "$key_file" /etc/apt/keyrings/tailscale.gpg; \
    chmod 0644 /etc/apt/keyrings/tailscale.gpg; \
    printf '%s\n' 'deb [signed-by=/etc/apt/keyrings/tailscale.gpg] https://pkgs.tailscale.com/stable/debian trixie main' \
        > /etc/apt/sources.list.d/tailscale.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends tailscale; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Keep policy in the image, outside the persistent SSH server state volume.
COPY sshd_config /usr/local/etc/sandboxed-agents/sshd_config

# The manager changes with every executable release; keep it below the package layers so they stay cached.
COPY --chmod=0755 manager.bin /usr/local/bin/sandboxed-agents-manager
RUN test -s /usr/local/bin/sandboxed-agents-manager \
        || { echo 'Manager missing: build the host executable with image/cmd/overlay.' >&2; exit 1; } \
    && mkdir -p /usr/local/share/sandboxed-agents \
    && /usr/local/bin/sandboxed-agents-manager record-versions

# Generate missing host keys only after the sandbox's SSH volume is mounted.
ENTRYPOINT ["sh", "-c", "set -e; ssh-keygen -A; exec /usr/sbin/sshd -D -e -f /usr/local/etc/sandboxed-agents/sshd_config"]
